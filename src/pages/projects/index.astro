---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<Base title="All Projects" description="Selected UI/UX design projects by Amirali Sarvestani." home={false}>
  <main class="archive">
    <header class="archive__head">
      <p class="archive__eyebrow">Selected case studies</p>
      <h1 class="display">All<br />Projects</h1>
      <p class="archive__intro">A collection of product, website and visual experience design projects.</p>
    </header>

    <section class="archive__grid" aria-label="Projects">
      {projects.map((project, index) => (
        <a class="project-card" href={`/projects/${project.id}/`}>
          <div class="project-card__image">
            <Image
              src={project.data.cover}
              alt={`${project.data.title} project cover`}
              widths={[640, 960, 1400]}
              sizes="(max-width: 760px) 100vw, 50vw"
              loading={index < 2 ? 'eager' : 'lazy'}
            />
            <span class="project-card__index">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <div class="project-card__meta">
            <div>
              <h2>{project.data.title}</h2>
              <p>{project.data.summary}</p>
            </div>
            <div class="project-card__aside">
              <span>{project.data.year}</span>
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M5 15 15 5M7 5h8v8" fill="none" stroke="currentColor" stroke-width="1.6" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </section>
  </main>
</Base>

<style>
  .archive {
    min-height: 100vh;
    padding: clamp(8rem, 17vh, 13rem) var(--gutter) clamp(5rem, 10vh, 9rem);
  }

  .archive__head {
    display: grid;
    grid-template-columns: 1fr minmax(14rem, 31rem);
    align-items: end;
    gap: 2rem;
    margin-bottom: clamp(5rem, 12vh, 10rem);
  }

  .archive__eyebrow {
    grid-column: 1 / -1;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--sky);
  }

  .archive h1 {
    font-size: clamp(4.5rem, 13vw, 13rem);
  }

  .archive__intro {
    padding-bottom: 0.5em;
    color: rgba(255, 255, 255, 0.64);
    font-size: clamp(1rem, 1.5vw, 1.35rem);
    line-height: 1.45;
  }

  .archive__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(4rem, 8vw, 8rem) clamp(1rem, 2vw, 2rem);
  }

  .project-card {
    display: block;
    text-decoration: none;
  }

  .project-card:nth-child(even) {
    translate: 0 clamp(3rem, 9vw, 9rem);
  }

  .project-card__image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: clamp(14px, 1.7vw, 24px);
    background: #111116;
  }

  .project-card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out), filter 0.5s;
  }

  .project-card:hover .project-card__image :global(img) {
    transform: scale(1.035);
    filter: brightness(0.78);
  }

  .project-card__index {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: rgba(8, 8, 10, 0.7);
    backdrop-filter: blur(12px);
    font-size: 0.72rem;
  }

  .project-card__meta {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.25rem;
  }

  .project-card h2 {
    font-size: clamp(1.7rem, 3vw, 3rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .project-card p {
    max-width: 42ch;
    margin-top: 0.65rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.45;
  }

  .project-card__aside {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8rem;
  }

  .project-card__aside svg {
    width: 1.25rem;
    height: 1.25rem;
    transition: translate 0.35s var(--ease-out);
  }

  .project-card:hover .project-card__aside svg {
    translate: 0.16rem -0.16rem;
  }

  @media (max-width: 760px) {
    .archive__head,
    .archive__grid {
      grid-template-columns: 1fr;
    }

    .archive__head {
      align-items: start;
    }

    .project-card:nth-child(even) {
      translate: 0;
    }

    .archive__grid {
      gap: 4rem;
    }
  }
</style>
