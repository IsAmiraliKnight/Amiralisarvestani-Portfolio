---
import site from '../data/site.json';

interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const base = home ? '' : '/';
const links = [
  { id: 'intro', label: 'Intro' },
  { id: 'works', label: 'Works' },
  { id: 'about', label: 'About' },
  { id: 'contact', label: 'Contact' },
];
---

<header class="site-header" data-header>
  <a class="site-header__logo" href="/" aria-label={`${site.name} — home`}>
    <!-- LOGO PLACEHOLDER: replace this text with your logo (e.g. <img src="/logo.svg" alt="" />) -->
    <span class="logo-placeholder">{site.shortName}<i>.</i></span>
  </a>

  <nav class="site-nav" aria-label="Main" data-nav>
    <span class="site-nav__ghost" data-nav-ghost aria-hidden="true"></span>
    <span class="site-nav__pill" data-nav-pill aria-hidden="true"></span>
    {
      links.map((l) => (
        <a href={`${base}#${l.id}`} data-nav-link={l.id}>
          {l.label}
        </a>
      ))
    }
  </nav>

  <a class="site-header__mail" href={`mailto:${site.email}`} data-copy={site.email}>
    <span class="roll roll--icon" aria-hidden="true">
      <span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg
        >
      </span>
      <span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          ><rect x="8" y="8" width="13" height="13" rx="2"></rect><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path></svg
        >
      </span>
      <span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
          ><path d="m5 12 5 5 9-10"></path></svg
        >
      </span>
    </span>
    <span class="roll">
      <span>{site.email}</span>
      <span>Click to copy email</span>
      <span>Copied to clipboard!</span>
    </span>
  </a>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: clamp(1rem, 2.4vw, 1.75rem) var(--gutter);
    pointer-events: none;
    color: #fff;
    transition: color 0.4s;
  }

  .site-header > * {
    pointer-events: auto;
  }

  .site-header.is-light {
    color: var(--ink);
  }

  .site-header__logo {
    justify-self: start;
    text-decoration: none;
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.45));
    transition: filter 0.4s;
  }

  .logo-placeholder {
    font-weight: 600;
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    letter-spacing: -0.03em;
  }

  .logo-placeholder i {
    font-style: normal;
    color: var(--sky);
  }

  .is-light .logo-placeholder i {
    color: var(--ink);
  }

  .is-light .site-header__logo,
  .is-light .site-header__mail {
    filter: none;
  }

  .site-nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: rgba(28, 28, 30, 0.55);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    backdrop-filter: blur(18px) saturate(1.2);
  }

  .site-nav a {
    position: relative;
    z-index: 3;
    padding: 0.5rem 0.95rem;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.3s, opacity 0.2s;
  }

  .site-nav a[data-active] {
    color: #0b0b0b;
  }

  .site-nav a:not([data-active]):hover {
    opacity: 0.7;
  }

  .site-nav__ghost,
  .site-nav__pill {
    position: absolute;
    top: 0;
    left: 0;
    width: 3em;
    height: 0;
    border-radius: 999px;
    pointer-events: none;
  }

  .site-nav__ghost {
    z-index: 1;
    background: rgba(255, 255, 255, 0.12);
    opacity: 0;
  }

  .site-nav__pill {
    z-index: 2;
    background: #fff;
    opacity: 0;
  }

  .site-header__mail {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.45));
  }

  .roll--icon {
    width: 16px;
  }

  .roll--icon > span {
    display: flex;
    align-items: center;
    height: 1.2em;
  }

  @media (max-width: 760px) {
    .site-header {
      grid-template-columns: auto 1fr;
    }
    .site-nav {
      justify-self: end;
    }
    .site-nav a {
      padding: 0.45rem 0.7rem;
      font-size: 13px;
    }
    .site-header__mail {
      display: none;
    }
  }

  @media (max-width: 420px) {
    /* the logo already links to the top, so "Intro" can go on small phones */
    .site-nav a[data-nav-link='intro'] {
      display: none;
    }
    .site-nav a {
      padding: 0.45rem 0.65rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const nav = header.querySelector<HTMLElement>('[data-nav]')!;
  const pill = nav.querySelector<HTMLElement>('[data-nav-pill]')!;
  const ghost = nav.querySelector<HTMLElement>('[data-nav-ghost]')!;
  const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];

  const box = (a: HTMLElement) => ({ x: a.offsetLeft, y: a.offsetTop, width: a.offsetWidth, height: a.offsetHeight });

  let active: HTMLAnchorElement | null = null;
  function setActive(a: HTMLAnchorElement | null, instant = false) {
    if (a === active) return;
    links.forEach((l) => l.toggleAttribute('data-active', l === a));
    if (!a) {
      gsap.to(pill, { opacity: 0, duration: 0.3 });
    } else {
      const d = instant || !active ? 0 : 0.55;
      gsap.to(pill, { ...box(a), opacity: 1, duration: d, ease: 'expo.out' });
    }
    active = a;
  }

  // hover "ghost" pill that follows the cursor between links
  links.forEach((a) => {
    a.addEventListener('pointerenter', () => {
      if (a === active) return gsap.to(ghost, { opacity: 0, duration: 0.2 });
      const visible = Number(gsap.getProperty(ghost, 'opacity')) > 0.05;
      gsap.to(ghost, { ...box(a), opacity: 1, duration: visible ? 0.45 : 0, ease: 'expo.out' });
      if (!visible) gsap.to(ghost, { opacity: 1, duration: 0.2 });
    });
  });
  nav.addEventListener('pointerleave', () => gsap.to(ghost, { opacity: 0, duration: 0.25 }));

  // scroll spy: highlight the section in view
  const sections = links
    .map((a) => ({ a, el: document.getElementById(a.dataset.navLink!) }))
    .filter((s): s is { a: HTMLAnchorElement; el: HTMLElement } => !!s.el);

  function spy() {
    const mid = innerHeight * 0.45;
    let current: HTMLAnchorElement | null = null;
    for (const s of sections) {
      const r = s.el.getBoundingClientRect();
      if (r.top <= mid && r.bottom > mid) current = s.a;
    }
    // on a project page, keep 'Works' highlighted
    if (!current && !document.getElementById('works')) current = links.find((l) => l.dataset.navLink === 'works') ?? null;
    setActive(current);

    // switch header to dark text while it sits over the light-blue contact section
    const contact = document.getElementById('contact');
    if (contact) {
      const r = contact.getBoundingClientRect();
      header.classList.toggle('is-light', r.top < 40 && r.bottom > 40);
    }
  }
  addEventListener('scroll', spy, { passive: true });
  addEventListener('resize', () => active && gsap.set(pill, box(active)));
  document.fonts?.ready.then(() => {
    spy();
    if (active) gsap.set(pill, box(active));
  });
  spy();

  // copy email on click
  document.querySelectorAll<HTMLElement>('[data-copy]').forEach((el) => {
    el.addEventListener('click', async (e) => {
      const value = el.dataset.copy;
      if (!value || value === 'copied' || !navigator.clipboard) return;
      e.preventDefault();
      try {
        await navigator.clipboard.writeText(value);
        el.dataset.copy = 'copied';
        setTimeout(() => (el.dataset.copy = value), 2000);
      } catch {
        location.href = `mailto:${value}`;
      }
    });
  });
</script>
